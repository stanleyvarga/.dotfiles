#!/bin/zsh

# Activity simulator to prevent Teams from going inactive
# Usage: activity-simulator [duration] [method]

# Default values
duration=${1:-20}      # Duration in seconds (default: 20)
method=${2:-"keyboard"} # Method: keyboard, mouse, or both

echo "🎯 Activity Simulator:"
echo "   Duration: ${duration}s"
echo "   Method: ${method}"
echo ""

# Function to simulate keyboard activity (press and release a modifier key)
simulate_keyboard_activity() {
    local duration=$1
    local steps=10
    local step_delay=$(echo "scale=2; $duration / $steps" | bc -l 2>/dev/null || echo "2")
    
    echo "⌨️  Simulating keyboard activity for ${duration}s..."
    
    for ((i=0; i<steps; i++)); do
        # Press and release shift key (very subtle)
        osascript -e 'tell application "System Events" to key down shift' 2>/dev/null
        sleep 0.1
        osascript -e 'tell application "System Events" to key up shift' 2>/dev/null
        
        echo -n "."
        sleep "$step_delay"
    done
    
    echo ""
    echo "✅ Keyboard activity completed"
}

# Function to simulate mouse activity (move cursor slightly)
simulate_mouse_activity() {
    local duration=$1
    local steps=20
    local step_delay=$(echo "scale=2; $duration / $steps" | bc -l 2>/dev/null || echo "1")
    
    echo "🖱️  Simulating mouse activity for ${duration}s..."
    
    # Get current cursor position
    local current_pos=$(osascript -e 'tell application "System Events" to get cursor location' 2>/dev/null)
    
    if [[ -n "$current_pos" ]]; then
        local x=$(echo "$current_pos" | cut -d',' -f1 | tr -d ' ')
        local y=$(echo "$current_pos" | cut -d',' -f2 | tr -d ' ')
        
        echo "   Starting from position: ($x, $y)"
        
        for ((i=0; i<steps; i++)); do
            # Move cursor in a small square pattern
            local offset=$((i % 4))
            case $offset in
                0) local new_x=$((x + 2)); local new_y=$y ;;      # Right
                1) local new_x=$x; local new_y=$((y + 2)) ;;      # Down
                2) local new_x=$((x - 2)); local new_y=$y ;;      # Left
                3) local new_x=$x; local new_y=$((y - 2)) ;;      # Up
            esac
            
            # Ensure coordinates are positive
            new_x=$((new_x < 0 ? 0 : new_x))
            new_y=$((new_y < 0 ? 0 : new_y))
            
            # Move cursor
            osascript -e "tell application \"System Events\" to set cursor location to {$new_x, $new_y}" 2>/dev/null || true
            
            echo -n "."
            sleep "$step_delay"
        done
        
        # Return to original position
        osascript -e "tell application \"System Events\" to set cursor location to {$x, $y}" 2>/dev/null || true
        
        echo ""
        echo "✅ Mouse activity completed"
    else
        echo "⚠️  Could not get current cursor position, skipping mouse activity"
    fi
}

# Function to simulate both keyboard and mouse activity
simulate_combined_activity() {
    local duration=$1
    local half_duration=$((duration / 2))
    
    echo "🔄 Simulating combined activity for ${duration}s..."
    
    # Run keyboard activity in background
    simulate_keyboard_activity "$half_duration" &
    local keyboard_pid=$!
    
    # Run mouse activity
    simulate_mouse_activity "$half_duration"
    
    # Wait for keyboard activity to complete
    wait "$keyboard_pid"
    
    echo "✅ Combined activity completed"
}

# Main execution
case "$method" in
    "keyboard")
        simulate_keyboard_activity "$duration"
        ;;
    "mouse")
        simulate_mouse_activity "$duration"
        ;;
    "both")
        simulate_combined_activity "$duration"
        ;;
    *)
        echo "Unknown method: $method"
        echo "Available methods: keyboard, mouse, both"
        exit 1
        ;;
esac

echo ""
echo "🎉 Activity simulation completed! This should help keep Teams active."
