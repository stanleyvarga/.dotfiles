#!/usr/bin/env sh
#
# Downloads the embedded video or audio on any web page straight to ~/Downloads/youtube.
# Uses yt-dlp: https://github.com/yt-dlp/yt-dlp

set -eu

MODE="video"

usage() {
  echo "Usage: $0 [-v|-a] <url>"
  echo "  -v     Download video as mp4 (default)"
  echo "  -a     Download audio only as mp3"
  echo "  -h     Display this help message"
  exit 1
}

while getopts ":vah" opt; do
  case "$opt" in
    v) MODE="video" ;;
    a) MODE="audio" ;;
    h) usage ;;
    \?)
      echo "Invalid option: -$OPTARG" >&2
      exit 1
      ;;
  esac
done

shift $((OPTIND - 1))

if [ $# -ne 1 ]; then
  usage
fi

if ! command -v yt-dlp >/dev/null 2>&1; then
  echo "yt-dlp is not installed. Please install it (https://github.com/yt-dlp/yt-dlp) and try again." >&2
  exit 1
fi

DOWNLOADS_DIR="$HOME/Downloads/youtube"
mkdir -p "$DOWNLOADS_DIR"

URL="$1"

if [ "$MODE" = "audio" ]; then
  yt-dlp -f "bestaudio/best" -x --audio-format mp3 -o "$DOWNLOADS_DIR/%(title)s.%(ext)s" "$URL"
else
  yt-dlp -f "bestvideo+bestaudio/best" --merge-output-format mp4 -o "$DOWNLOADS_DIR/%(title)s.%(ext)s" "$URL"
fi
