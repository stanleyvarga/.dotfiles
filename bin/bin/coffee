#!/bin/zsh

# Disable echo of the interrupt character
stty -echoctl

start_date=$(date +"%d-%m-%Y %H:%M")
sleep_duration=$((5))  # 5 seconds between cycles for testing

caffeinate -d &

function quit_script {
    trap - INT  # Reset the trap to default behavior
    duration=$(( SECONDS / 3600 ))h:$(( (SECONDS / 60) % 60 ))m:$(( SECONDS % 60 ))s
    echo "⏱️  $duration"
    # Re-enable echo of the interrupt character before exiting
    stty echoctl
    exit 0
}

trap 'quit_script' INT  # Redirect error output to /dev/null

# Function to simulate keyboard activity to keep Teams active
simulate_activity() {
    local duration=5  # 5 seconds for faster testing
    local steps=5
    local step_delay=$(echo "scale=2; $duration / $steps" | bc -l 2>/dev/null || echo "1")
    
    for ((i=0; i<steps; i++)); do
        # Press and release shift key (very subtle, won't interfere with typing)
        osascript -e 'tell application "System Events" to key down shift' 2>/dev/null
        sleep 0.1
        osascript -e 'tell application "System Events" to key up shift' 2>/dev/null
        
        sleep "$step_delay"
    done
}

while true; do
    echo "☕️"
    
    simulate_activity
    
    sleep $sleep_duration
done


