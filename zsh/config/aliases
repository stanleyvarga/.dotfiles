alias ~="cd ~"

alias d='dirs -v | head -10' # Directory stack lookup
alias 1='cd -1'
alias 2='cd -2'
alias 3='cd -3'
alias 4='cd -4'
alias 5='cd -5'
alias 6='cd -6'
alias 7='cd -7'
alias 8='cd -8'
alias 9='cd -9'

alias grep='grep --color=auto --exclude-dir={.bzr,CVS,.git,.hg,.svn}'
alias -g G='| grep -i'

# File listing: eza when installed, graceful fallback otherwise
if (( $+commands[eza] )); then
  alias ls='eza -lbF --group-directories-first --icons --color-scale'
  alias l='ls'
  alias la='eza -lbhHigUmuSa --time-style=long-iso --color-scale'
  alias ll='la'
  alias lt='eza --tree --level=2 --icons'
  alias ld='l -D'
  alias lC='la --sort=changed'
  alias lM='la --sort=modified'
  alias lS='la --sort=size'
  alias lX='la --sort=extension'
else
  alias ls='ls --color=auto'
  alias l='ls -lh'
  alias la='ls -lah'
  alias ll='la'
fi

# GIT
gcmp() { git commit -m "$1" && git push; }
gcm() { git commit -m "$1"; }

