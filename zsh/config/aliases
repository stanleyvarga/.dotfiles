alias e:alias="code $DOTFILES/zsh/config/aliases"
alias e:path="code $DOTFILES/zsh/config/paths"
alias e:zshrc="code $DOTFILES/zsh/.zshrc"
alias e:plugins="code $DOTFILES/zsh/zsh_plugins.txt"
alias e:starship="code $DOTFILES/starship/starship.toml"
alias c="clear" # clear terminal
alias x="exit"  # closes terminal
# Never alias `source` to `source ~/.zshrc` — it shadows the builtin and causes recursion.
alias rzsh="builtin source ~/.zshrc"
alias rzs="builtin source ~/.zshrc"

