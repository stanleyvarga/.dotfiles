# Better cat alternative with syntax highlighting (Debian/Ubuntu package is batcat)
if (( $+commands[bat] )); then
  alias bat="bat --theme=OneHalfDark --paging=never --style=full"
elif (( $+commands[batcat] )); then
  alias bat="batcat --theme=OneHalfDark --paging=never --style=full"
fi
[[ -n "${aliases[bat]:-}" ]] && alias cat="bat"

alias week='date +%V'
alias runp='lsof -ni'
alias sshdir='cd ~/.ssh'
alias wttr="curl wttr.in"
(( $+commands[gping] )) && alias ping="gping"
alias python="python3"
