# Deduplicated, fork-free PATH & FPATH setup (macOS + Linux).
# Node, Ruby, Python, and global CLIs are managed by mise (no lazy-loading wrappers).

typeset -gU path PATH fpath FPATH

[[ -d "$HOME/.agentmemory/bin" ]] && path=("$HOME/.agentmemory/bin" $path)
[[ -d "$HOME/.bun/bin" ]] && path=("$HOME/.bun/bin" $path)

if [[ $OSTYPE == darwin* ]]; then
  [[ -d /opt/homebrew/bin ]] && path=(/opt/homebrew/bin /opt/homebrew/sbin $path)
  [[ -d /usr/local/bin ]] && path=(/usr/local/bin $path)

  # Homebrew zsh completions
  [[ -d /opt/homebrew/share/zsh/site-functions ]] && fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
  [[ -d /usr/local/share/zsh/site-functions ]] && fpath=(/usr/local/share/zsh/site-functions $fpath)

  [[ -d /opt/homebrew/opt/openjdk@11/bin ]] && path=(/opt/homebrew/opt/openjdk@11/bin $path)
  [[ -d /opt/homebrew/opt/openjdk@17/bin ]] && path=(/opt/homebrew/opt/openjdk@17/bin $path)
  [[ -d "$HOME/Library/Android/sdk/platform-tools" ]] && path=($path "$HOME/Library/Android/sdk/platform-tools")

  if [[ -d "$HOME/perl5/bin" ]]; then
    path=("$HOME/perl5/bin" $path)
    export PERL5LIB="$HOME/perl5/lib/perl5${PERL5LIB:+:${PERL5LIB}}"
    export PERL_LOCAL_LIB_ROOT="$HOME/perl5${PERL_LOCAL_LIB_ROOT:+:${PERL_LOCAL_LIB_ROOT}}"
    export PERL_MB_OPT="--install_base \"$HOME/perl5\""
    export PERL_MM_OPT="INSTALL_BASE=$HOME/perl5"
  fi
fi

if [[ -d /usr/local/share/dotnet ]]; then
  export DOTNET_ROOT="/usr/local/share/dotnet"
  path=("$DOTNET_ROOT" $path)
fi

[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)
[[ -d "$HOME/bin" ]] && path=($path "$HOME/bin")

# Keep mise shims ahead of Homebrew/system bins before `mise activate` runs
[[ -d "$HOME/.local/share/mise/shims" ]] && path=("$HOME/.local/share/mise/shims" $path)

export EDITOR="vim"
export OS_EDITOR="code"
