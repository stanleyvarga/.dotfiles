# Optimized paths with lazy NVM loading
export PYENV_ROOT="$HOME/.pyenv"
export NVM_DIR="$HOME/.nvm"

# Lazy load NVM — Homebrew layout on macOS, standard ~/.nvm on Linux
_nvm_script() {
  if [[ -s /opt/homebrew/opt/nvm/nvm.sh ]]; then
    echo "/opt/homebrew/opt/nvm/nvm.sh"
  elif [[ -s /usr/local/opt/nvm/nvm.sh ]]; then
    echo "/usr/local/opt/nvm/nvm.sh"
  elif [[ -s "$HOME/.nvm/nvm.sh" ]]; then
    echo "$HOME/.nvm/nvm.sh"
  fi
}

_nvm_completion() {
  if [[ -s /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm ]]; then
    echo "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
  elif [[ -s /usr/local/opt/nvm/etc/bash_completion.d/nvm ]]; then
    echo "/usr/local/opt/nvm/etc/bash_completion.d/nvm"
  elif [[ -s "$HOME/.nvm/bash_completion" ]]; then
    echo "$HOME/.nvm/bash_completion"
  fi
}

function nvm() {
  unfunction nvm node npm npx yarn
  local ns
  ns="$(_nvm_script)"
  [[ -n "$ns" ]] && \. "$ns"
  local nc
  nc="$(_nvm_completion)"
  [[ -n "$nc" && -r "$nc" ]] && \. "$nc"
  nvm "$@"
}

function node() {
  unfunction nvm node npm npx yarn
  local ns
  ns="$(_nvm_script)"
  [[ -n "$ns" ]] && \. "$ns"
  local nc
  nc="$(_nvm_completion)"
  [[ -n "$nc" && -r "$nc" ]] && \. "$nc"
  node "$@"
}

function npm() {
  unfunction nvm node npm npx yarn
  local ns
  ns="$(_nvm_script)"
  [[ -n "$ns" ]] && \. "$ns"
  local nc
  nc="$(_nvm_completion)"
  [[ -n "$nc" && -r "$nc" ]] && \. "$nc"
  npm "$@"
}

function npx() {
  unfunction nvm node npm npx yarn
  local ns
  ns="$(_nvm_script)"
  [[ -n "$ns" ]] && \. "$ns"
  local nc
  nc="$(_nvm_completion)"
  [[ -n "$nc" && -r "$nc" ]] && \. "$nc"
  npx "$@"
}

function yarn() {
  unfunction nvm node npm npx yarn
  local ns
  ns="$(_nvm_script)"
  [[ -n "$ns" ]] && \. "$ns"
  local nc
  nc="$(_nvm_completion)"
  [[ -n "$nc" && -r "$nc" ]] && \. "$nc"
  command yarn "$@"
}

export PATH="/usr/local/bin:$PATH"
export PATH="$PATH:$HOME/bin"

if [[ "$(uname -s)" == Darwin ]]; then
  export PATH="$PATH:$HOME/Library/Android/sdk/platform-tools"
  export PATH="/opt/homebrew/bin:$PATH"
  export PATH="/opt/homebrew/opt/openjdk@11/bin:$PATH"
  export PATH="/opt/homebrew/opt/openjdk@17/bin:$PATH"
  # Optional local::lib (adjust username/path if you use this machine)
  if [[ -d "$HOME/perl5/bin" ]]; then
    export PATH="$HOME/perl5/bin${PATH:+:${PATH}}"
    export PERL5LIB="$HOME/perl5/lib/perl5${PERL5LIB:+:${PERL5LIB}}"
    export PERL_LOCAL_LIB_ROOT="$HOME/perl5${PERL_LOCAL_LIB_ROOT:+:${PERL_LOCAL_LIB_ROOT}}"
    export PERL_MB_OPT="--install_base \"$HOME/perl5\""
    export PERL_MM_OPT="INSTALL_BASE=$HOME/perl5"
  fi
fi

export PATH="${HOME}/.pyenv/shims:${PATH}"
export PATH="$PYENV_ROOT/bin:$PYENV_ROOT/shims:$PATH"

export EDITOR="vim"
export OS_EDITOR="code"
