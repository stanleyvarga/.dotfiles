# Cached tool initialization (macOS + Ubuntu Linux).
# Avoids spawning subprocesses on every shell start while keeping hooks active immediately.

# Fallback if zsh-defer is unavailable (e.g. before Antidote is installed)
(( $+functions[zsh-defer] )) || zsh-defer() { "$@"; }

# Cache `bin args...` output to ~/.cache/zsh/<name>.zsh; auto-rebuilds when binary updates.
_cached_eval() {
  local name=$1 bin=$2
  shift 2
  local bin_path=${commands[$bin]:-}
  [[ -n $bin_path ]] || return 1
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/${name}.zsh"
  if [[ ! -s $cache || $bin_path -nt $cache ]]; then
    mkdir -p "${cache:h}"
    "$bin_path" "$@" >| "$cache" 2>/dev/null || { command rm -f "$cache"; return 1; }
    zcompile -U "$cache" 2>/dev/null || true
  fi
  source "$cache"
}

# 1. Directory jumper: zoxide (eager cached ~0.3ms so every `cd` trains frecency)
if (( $+commands[zoxide] )); then
  _cached_eval zoxide zoxide init zsh
fi

# 2. Worktrunk: wt (cached ~0.6ms instead of ~56ms live)
if (( $+commands[wt] )); then
  _cached_eval wt wt config shell init zsh
fi

# 3. Runtime manager: mise
# ~/.local/share/mise/shims is already first on PATH via ~/.zshenv so node/npm/npx
# and global CLIs work immediately (0ms). Defer full `mise activate zsh` until after
# first prompt so chpwd direct-PATH switching activates with the live PATH and 0ms lag.
if (( $+commands[mise] )); then
  zsh-defer -c 'eval "$(command mise activate zsh)"'
fi

# Interactive TTY-only tools (skip under TERM=dumb to avoid ZLE / starship warnings)
if [[ ${TERM:-dumb} != dumb ]]; then
  # 4. Prompt: Starship (fallback to lightweight built-in prompt if not installed)
  if (( $+commands[starship] )); then
    _cached_eval starship starship init zsh
  else
    PROMPT='%F{cyan}%~%f %(?.%F{green}.%F{red})➜%f '
  fi

  # 5. Fuzzy finder: fzf (Ctrl-T files, Ctrl-G cd; loaded BEFORE Atuin so Atuin owns Ctrl-R)
  if (( $+commands[fzf] )); then
    if (( $+commands[fd] )); then
      export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --follow --exclude .git'
      export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
      export FZF_ALT_C_COMMAND='fd --type d --strip-cwd-prefix --hidden --follow --exclude .git --exclude node_modules'
    fi
    if (( $+commands[bat] )); then
      export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
    elif (( $+commands[batcat] )); then
      export FZF_CTRL_T_OPTS="--preview 'batcat --color=always --style=numbers --line-range=:200 {}'"
    fi
    if (( $+commands[eza] )); then
      export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --icons --color=always {} | head -n 100'"
    fi

    # fzf >= 0.48 supports `fzf --zsh`; older Ubuntu apt packages ship example scripts instead.
    if ! _cached_eval fzf fzf --zsh; then
      [[ -r /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
      [[ -r /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh
    fi

    # Bind Ctrl+G ("Go") to fzf-cd-widget — works identically on macOS and Ubuntu without Option/Meta setup
    if (( $+widgets[fzf-cd-widget] )); then
      bindkey '^G' fzf-cd-widget
    fi
  fi

  # 6. Shell history: Atuin (deferred cached — 0ms prompt lag, owns Ctrl-R & records all commands)
  if (( $+commands[atuin] )); then
    zsh-defer _cached_eval atuin atuin init zsh
  fi
fi
