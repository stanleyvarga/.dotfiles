## Create a folder and move into it in one command
function mkcd() { mkdir -p "$@" && cd "$_"; }

# ytdl_all - Download multiple YouTube videos in parallel
# Usage: ytdl_all --jobs 3 "URL1" "URL2" "URL3"
#        ytdl_all -j 5 "URL1" "URL2"
#        ytdl_all "URL1" "URL2"  (defaults to 3 jobs)
#        ytdl_all --file urls.txt

ytdl_all() {
    local jobs=3
    local urls=()
    local quality="bestvideo+bestaudio/best"  # Use proven format from your script
    local output_dir=""
    local file=""
    local dry_run=false
    local verbose=false
    local audio_only=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --jobs|-j)
                if [[ ! "$2" =~ ^[0-9]+$ ]] || [[ "$2" -le 0 ]]; then
                    echo "❌ Error: Jobs must be a positive integer"
                    return 1
                fi
                jobs="$2"
                shift 2
                ;;
            --quality|-q)
                quality="$2"
                shift 2
                ;;
            --audio|-a)
                audio_only=true
                quality="bestaudio/best"
                shift
                ;;
            --output|-o)
                output_dir="$2"
                shift 2
                ;;
            --file|-f)
                file="$2"
                shift 2
                ;;
            --dry-run|-n)
                dry_run=true
                shift
                ;;
            --verbose|-v)
                verbose=true
                shift
                ;;
            --retry|--fallback)
                echo "🔄 Using fallback method for blocked videos..."
                quality="worst"  # Sometimes lower quality works when 4K is blocked
                shift
                ;;
            --help|-h)
                echo "📥 ytdl_all - Parallel YouTube Video Downloader"
                echo ""
                echo "Usage: ytdl_all [OPTIONS] URL1 URL2 URL3..."
                echo "       ytdl_all [OPTIONS] --file urls.txt"
                echo ""
                echo "Options:"
                echo "  -j, --jobs N        Number of parallel downloads (default: 3, max: 10)"
                echo "  -q, --quality Q     Quality format (default: 'bestvideo+bestaudio/best')"
                echo "  -a, --audio         Download audio only"
                echo "  -o, --output DIR    Output directory (default: ~/Downloads/youtube)"
                echo "  -f, --file FILE     Read URLs from file (one per line)"
                echo "  -n, --dry-run       Show what would be downloaded without downloading"
                echo "  -v, --verbose       Verbose output from yt-dlp"
                echo "  --retry             Use fallback method for blocked videos"
                echo "  -h, --help          Show this help"
                echo ""
                echo "Quality presets:"
                echo "  video = bestvideo+bestaudio/best (default)"
                echo "  audio = bestaudio/best"
                echo "  4k    = bestvideo[height<=2160]+bestaudio/best"
                echo "  1080p = bestvideo[height<=1080]+bestaudio/best"
                echo "  720p  = bestvideo[height<=720]+bestaudio/best"
                echo ""
                echo "Examples:"
                echo "  ytdl_all --jobs 5 \"https://youtube.com/watch?v=abc\" \"https://youtube.com/watch?v=def\""
                echo "  ytdl_all -j 2 -a -o ~/Downloads/Music \"URL1\" \"URL2\"  # Audio only"
                echo "  ytdl_all --file my_urls.txt --jobs 4"
                echo "  ytdl_all --dry-run \"URL1\" \"URL2\"  # Preview what would be downloaded"
                return 0
                ;;
            -*)
                echo "❌ Error: Unknown option $1"
                echo "Use --help for usage information"
                return 1
                ;;
            *)
                # Clean playlist parameters from command line URLs too
                cleaned_url=$(echo "$1" | sed 's/&list=[^&]*//g' | sed 's/&index=[^&]*//g' | sed 's/&ab_channel=[^&]*//g')
                urls+=("$cleaned_url")
                shift
                ;;
        esac
    done
    
    # Handle quality presets (keeping your script's proven formats)
    case "$quality" in
        4k) quality="bestvideo[height<=2160]+bestaudio/best" ;;
        1080p) quality="bestvideo[height<=1080]+bestaudio/best" ;;
        720p) quality="bestvideo[height<=720]+bestaudio/best" ;;
        audio) quality="bestaudio/best" ;;
        video) quality="bestvideo+bestaudio/best" ;;
    esac
    
    # Read URLs from file if specified
    if [[ -n "$file" ]]; then
        if [[ ! -f "$file" ]]; then
            echo "❌ Error: File '$file' not found"
            return 1
        fi
        
        while IFS= read -r line; do
            # Skip empty lines and comments
            if [[ -n "$line" && "$line" != \#* ]]; then
                # Clean playlist parameters from URLs to avoid playlist download issues
                cleaned_url=$(echo "$line" | sed 's/&list=[^&]*//g' | sed 's/&index=[^&]*//g' | sed 's/&ab_channel=[^&]*//g')
                urls+=("$cleaned_url")
            fi
        done < "$file"
    fi
    
    # Validate inputs
    if [[ ${#urls[@]} -eq 0 ]]; then
        echo "❌ Error: No URLs provided"
        echo "Use --help for usage information"
        return 1
    fi
    
    # Cap jobs at reasonable limit
    if [[ "$jobs" -gt 10 ]]; then
        echo "⚠️  Warning: Limiting jobs to 10 to avoid overwhelming YouTube's servers"
        jobs=10
    fi
    
    # Check dependencies
    local missing_deps=()
    command -v parallel &> /dev/null || missing_deps+=("parallel")
    command -v yt-dlp &> /dev/null || missing_deps+=("yt-dlp")
    
    if [[ ${#missing_deps[@]} -gt 0 ]]; then
        echo "❌ Error: Missing dependencies: ${missing_deps[*]}"
        echo "Install with: brew install ${missing_deps[*]}"
        return 1
    fi
    
    # Build yt-dlp command (simplified like your working script)
    local ytdlp_cmd="yt-dlp --no-playlist -f '$quality'"
    
    # Set output format and directory like your script
    if [[ -n "$output_dir" ]]; then
        ytdlp_cmd+=" -o '$output_dir/%(title)s.%(ext)s'"
    else
        # Default to ~/Downloads/youtube like your script
        local default_dir="$HOME/Downloads/youtube"
        mkdir -p "$default_dir"
        ytdlp_cmd+=" -o '$default_dir/%(title)s.%(ext)s'"
        output_dir="$default_dir"
    fi
    
    [[ "$verbose" == true ]] && ytdlp_cmd+=" --verbose"
    
    # Show preview
    echo "🚀 Parallel YouTube Download Configuration:"
    echo "   📊 Jobs: $jobs"
    echo "   🎥 Quality: $quality"
    echo "   📁 Output: ${output_dir:-"current directory"}"
    echo "   🔗 URLs: ${#urls[@]}"
    [[ "$dry_run" == true ]] && echo "   🧪 Mode: DRY RUN (no actual downloads)"
    echo ""
    
    # Show URLs if not too many
    if [[ ${#urls[@]} -le 10 ]]; then
        echo "📋 URLs to download:"
        printf '   %s\n' "${urls[@]}"
        echo ""
    fi
    
    # Confirm for large batches
    if [[ ${#urls[@]} -gt 20 ]]; then
        echo "⚠️  You're about to download ${#urls[@]} videos. Continue? (y/N)"
        read -r response
        [[ "$response" != [Yy]* ]] && { echo "Cancelled."; return 0; }
    fi
    
    # Dry run mode
    if [[ "$dry_run" == true ]]; then
        echo "🧪 DRY RUN - Commands that would be executed:"
        printf '%s\n' "${urls[@]}" | head -3 | while read -r url; do
            echo "   $ytdlp_cmd '$url'"
        done
        [[ ${#urls[@]} -gt 3 ]] && echo "   ... and $((${#urls[@]} - 3)) more"
        return 0
    fi
    
    # Create output directory if specified
    [[ -n "$output_dir" ]] && mkdir -p "$output_dir"
    
    # Start timer
    local start_time=$(date +%s)
    
    # Execute parallel downloads with extension fixing (like your script)
    printf '%s\n' "${urls[@]}" | parallel -j "$jobs" --bar "
        $ytdlp_cmd {} && 
        cd '$output_dir' && 
        for file in *; do 
            [[ -f \"\$file\" && ! \"\$file\" =~ \\.(mp4|mkv|webm|mp3|m4a|ogg)\$ ]] && 
            mv \"\$file\" \"\${file%.*}.mp4\" 2>/dev/null || true
        done
    "
    local exit_code=$?
    
    # Show completion stats
    local end_time=$(date +%s)
    local duration=$((end_time - start_time))
    
    echo ""
    if [[ $exit_code -eq 0 ]]; then
        echo "✅ All downloads completed successfully!"
    else
        echo "⚠️  Downloads completed with some errors (exit code: $exit_code)"
    fi
    echo "⏱️  Total time: ${duration}s"
    
    return $exit_code
}

# Enhanced completion with file paths and presets
_ytdl_all_completion() {
    local context state line
    
    _arguments \
        '(-j --jobs)'{-j,--jobs}'[Number of parallel jobs]:jobs:(1 2 3 4 5 8 10)' \
        '(-q --quality)'{-q,--quality}'[Video quality]:quality:(4k 1080p 720p audio "best[height<=2160]" "best[height<=1080]")' \
        '(-o --output)'{-o,--output}'[Output directory]:directory:_directories' \
        '(-f --file)'{-f,--file}'[File with URLs]:file:_files' \
        '(-n --dry-run)'{-n,--dry-run}'[Dry run mode]' \
        '(-v --verbose)'{-v,--verbose}'[Verbose output]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '*:YouTube URL:_urls'
}

compdef _ytdl_all_completion ytdl_all
