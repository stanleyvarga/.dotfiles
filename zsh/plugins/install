# Default must use $HOME: tilde is not expanded inside "${...}" quotes in bash.
omz_custom="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

# you-should-use - reminds you to use aliases
if [ ! -d "$omz_custom/plugins/you-should-use" ]; then
    git clone https://github.com/MichaelAquilina/zsh-you-should-use.git "$omz_custom/plugins/you-should-use"
fi

# fd-zsh - aliases for fd
if [ ! -d "$omz_custom/plugins/fd-zsh" ]; then
    git clone https://github.com/MohamedElashri/fd-zsh.git "$omz_custom/plugins/fd-zsh"
fi

# zsh-defer - lazy loading for ZSH
if [ ! -d "$omz_custom/plugins/zsh-defer" ]; then
    git clone https://github.com/romkatv/zsh-defer.git "$omz_custom/plugins/zsh-defer"
fi
